# Episode work stays on this machine. Only the blank template is in git.
episodes/*
!episodes/_template/
!episodes/_template/**

# Video never goes to git. Photos (jpg/png) and music/sfx (mp3) are allowed.
*.mp4
*.mov
*.mkv
*.webm
*.avi
*.m4v
