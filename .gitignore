raw-clips/*
output/*
!raw-clips/.gitkeep
!output/.gitkeep
.build_overlays.ass
__pycache__/
.venv/
node_modules/
.DS_Store
.hyperframes/
.waveform-cache/
.thumbnails/
*.contact.jpg
references/*
