# Required — powers the actual thumbnail generation via Gemini 3 Pro Image Preview (Nano Banana Pro).
# Get yours at: https://aistudio.google.com/app/apikey
# Requires a Google account + billing for pay-as-you-go image generation.
GEMINI_API_KEY=your-gemini-key-here

# Optional — free tier available. Powers Step 1b (searching YouTube for high-performing thumbnails
# in the same niche to use as style examples for Gemini). Skip this and the skill still works —
# you just lose the "study what's already winning" step.
# Get yours at: https://scrapecreators.com
SCRAPECREATORS_API_KEY=your-scrape-creators-key-here
